## Example environment variables (copy to .env and adjust). DO NOT commit real secrets.

# Mongo local
MONGODB_URI=mongodb://localhost:27017/oldmarket
# Mongo Atlas template (replace USERNAME, PASSWORD, HOST):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/oldmarket?retryWrites=true&w=majority&appName=Cluster0

PORT=8080
NODE_ENV=development

# JWT secrets (use long random strings in real .env)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

# Comma separated origins allowed for CORS
CORS_ORIGINS=http://localhost:5173

# Rate limiting overrides (optional) – leave blank to use defaults
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120

# Optional: public base URL of backend (used for emails / links)
# APP_BASE_URL=http://localhost:8080
